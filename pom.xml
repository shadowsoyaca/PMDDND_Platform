<?xml version="1.0" encoding="UTF-8"?>
<!-- ==========================================================================
     PMD D&D Platform - Maven build file

     Names the project, lists the libraries it needs, and defines the build
     steps. ".\mvnw.cmd clean package" produces one runnable JAR in target/.
     ========================================================================== -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<!-- The POM format version. Always 4.0.0. Not the project's version. -->
	<modelVersion>4.0.0</modelVersion>

	<!-- Spring Boot's parent POM. It sets the version of every library it manages,
	     so most dependency blocks below carry no version tag, and it sets the
	     compiler and packaging defaults. -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.15</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<!-- groupId, artifactId and version together name the project and the built
	     file, target/dndplatform-<version>.jar. -->
	<groupId>com.pmd</groupId>
	<artifactId>dndplatform</artifactId>

	<!-- phase.story.child, bumped on each story branch. Names the built file,
	     target/dndplatform-<version>.jar, which the deploy script and the
	     build-info execution further down both read the version from. -->
	<version>2.5.9</version>

	<!-- Empty placeholders left by Spring Initializr. They are only read when a
	     library is published to a public repository. -->
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>

	<!-- java.version is read by the parent's compiler settings and pins the build
	     to Java 17. -->
	<properties>
		<java.version>17</java.version>
	</properties>

	<!-- The libraries the code needs. A starter is a bundle of several libraries.
	     <scope> says when a dependency is available: none is compiling, testing
	     and running; runtime is testing and running; test is tests only. -->
	<dependencies>

		<!-- The web layer: embedded Tomcat, Spring MVC, JSON handling. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Spring Security. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- JPA / Hibernate. Reads and writes database rows as Java objects. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Validation annotations such as @NotBlank and @Size, checked before the
		     controller runs. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Flyway, which owns the database schema: the core engine and the
		     PostgreSQL support module. -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- The PostgreSQL driver, at runtime scope. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- The test toolkit: JUnit, AssertJ, Mockito, MockMvc. Test scope. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Lets tests simulate logged-in and logged-out requests. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!-- ======================================================================
	     BUILD

	     Each <execution> binds a plugin goal to a phase. The phases used here,
	     in the order Maven runs them:
	       generate-resources  - before Java is compiled
	       prepare-package     - after compilation, before the JAR is sealed
	       package             - target/classes/ is zipped into the JAR
	     ====================================================================== -->
	<build>
		<plugins>

			<!-- Repackages the plain JAR into a runnable fat JAR. The build-info
			     execution writes META-INF/build-info.properties, holding the
			     version and the build time, which HealthController reads. Its id
			     must differ from "repackage", and the goal names no phase. -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>build-info</id>
						<goals><goal>build-info</goal></goals>
					</execution>
				</executions>
			</plugin>

			<!-- ==============================================================
			     Builds the React frontend as part of the Maven build. Node and
			     npm are pinned and downloaded into frontend/node/. All four
			     executions run in prepare-package, in the order written: install
			     Node, npm ci, npm run build, npm test. This plugin is declared
			     above maven-resources-plugin, and that order matters.
			     ============================================================== -->
			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<version>1.15.1</version>
				<configuration>
					<workingDirectory>frontend</workingDirectory>
					<nodeVersion>v24.12.0</nodeVersion>
					<npmVersion>11.6.2</npmVersion>
				</configuration>
				<executions>
					<execution>
						<id>install-node-and-npm</id>
						<phase>prepare-package</phase>
						<goals><goal>install-node-and-npm</goal></goals>
					</execution>
					<execution>
						<id>npm-ci</id>
						<phase>prepare-package</phase>
						<goals><goal>npm</goal></goals>
						<configuration><arguments>ci</arguments></configuration>
					</execution>
					<execution>
						<id>npm-build</id>
						<phase>prepare-package</phase>
						<goals><goal>npm</goal></goals>
						<configuration><arguments>run build</arguments></configuration>
					</execution>

					<!-- Runs the frontend tests. A failing test fails the package
					     build, so no JAR is produced. -->
					<execution>
						<id>npm-test</id>
						<phase>prepare-package</phase>
						<goals><goal>npm</goal></goals>
						<configuration><arguments>test</arguments></configuration>
					</execution>
				</executions>
			</plugin>

			<!-- ==============================================================
			     Copies frontend/dist/ into the JAR's static folder during
			     prepare-package. filtering is false, so the files are copied
			     byte for byte.
			     ============================================================== -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-frontend-build</id>
						<phase>prepare-package</phase>
						<goals><goal>copy-resources</goal></goals>
						<configuration>
							<outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
							<resources>
								<resource>
									<directory>frontend/dist</directory>
									<filtering>false</filtering>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>

</project>