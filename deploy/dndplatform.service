# dndplatform.service — PMD D&D Platform (Spring Boot)
#
# This file exists in two places: live at /etc/systemd/system/dndplatform.service
# on the server, and as a copy in the repository at deploy/dndplatform.service.
# They are kept identical. If they ever differ, the LIVE server file wins.
[Unit]
Description=PMD D&D Platform (Spring Boot)
After=network.target
[Service]
User=dndapp
Group=dndapp
WorkingDirectory=/opt/dndplatform
# The four values the app cannot start without: the database password, and the
# three owner seed values. The file is root only. systemd reads it as root and
# hands the values to the process, so the dndapp account never needs access to
# the file itself.
EnvironmentFile=/etc/dndplatform/dndplatform.env
# current.jar is a symlink pointing at the live build inside
# /opt/dndplatform/releases. Deploying moves the symlink, so this line never has
# to change again. Rolling back is moving it back.
ExecStart=/usr/bin/java -jar /opt/dndplatform/current.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
# --- Hardening ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/dndplatform
[Install]
WantedBy=multi-user.target