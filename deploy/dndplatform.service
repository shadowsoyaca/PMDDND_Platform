# dndplatform.service — PMD D&D Platform (Spring Boot)   [Phase 1, Story 9]
#
# REFERENCE COPY of the authoritative file on the server at
#     /etc/systemd/system/dndplatform.service
# Verified line-for-line against the live unit on July 6, 2026.
# If they ever diverge again, the LIVE server file wins.
[Unit]
Description=PMD D&D Platform (Spring Boot)
After=network.target
[Service]
User=dndapp
Group=dndapp
WorkingDirectory=/opt/dndplatform
ExecStart=/usr/bin/java -jar /opt/dndplatform/dndplatform.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
# --- Hardening ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/dndplatform
[Install]
WantedBy=multi-user.target