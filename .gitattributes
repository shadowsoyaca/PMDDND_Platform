# Stores every text file with LF in the repository and checks out the native ending. Stays first.
* text=auto

# Keeps mvnw at LF.
mvnw text eol=lf

# Keeps the Windows script at CRLF.
*.cmd text eol=crlf

# Keeps the shell scripts and the service unit at LF.
*.sh text eol=lf
*.service text eol=lf

# Keeps workflow files at LF. Deliberately redundant with the text=auto line above.
.github/workflows/*.yml text eol=lf

# Keeps the Caddyfile at LF.
Caddyfile text eol=lf

# Image files. PNG is binary. SVG is text on purpose.
*.png binary
*.svg text eol=lf

# Font and icon files are binary, with no line ending conversion.
*.woff2 binary
*.woff binary
*.ttf binary
*.otf binary
*.ico binary